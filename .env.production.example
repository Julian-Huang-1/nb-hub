# Create the real file with `make prod-env`, then set DOMAIN to your DNS hostname.
DOMAIN=
POSTGRES_PASSWORD=
JWT_SECRET=
ALLOW_SIGNUP=true
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=
AUTH_TOKEN_TTL=720h
# Configure SMTP (STARTTLS) or Resend for email login.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Google sign-in is optional; callback is https://DOMAIN/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
API_IMAGE=nb-hub-api:local
WEB_IMAGE=nb-hub-web:local
# Match the Alibaba Cloud server architecture when building on another machine.
DEPLOY_PLATFORM=linux/amd64

# Optional static hosting. Must use a different registrable domain from DOMAIN.
# Enable with docker-compose.sites.yml and supply a wildcard TLS certificate.
NB_HUB_CONTENT_DOMAIN=
