# hi — zsh integration (generated by `hi init zsh`)
# Recommended: add `eval "$(hi init zsh)"` to ~/.zshrc instead of sourcing this file directly.
hi() {
  if [[ $# -eq 0 ]]; then
    command hi
    return
  fi
  local cmd
  cmd=$(command hi "$@" 2>/tmp/hi-err)
  local code=$?
  if [[ $code -ne 0 ]]; then
    cat /tmp/hi-err >&2
    return $code
  fi
  [[ -n "$cmd" ]] && print -z "$cmd"
}
