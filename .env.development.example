APP_ENV=development
POSTGRES_USER=nbhub_dev
POSTGRES_PASSWORD=nbhub_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://nbhub_dev:nbhub_dev@127.0.0.1:5432/nbhub_dev?sslmode=disable
NB_HUB_LISTEN_ADDR=127.0.0.1:8080
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
NB_HUB_API_URL=http://localhost:8080

# Development only; ignored in production. Send a code before entering it.
NB_HUB_DEV_VERIFICATION_CODE=888888
AUTH_TOKEN_TTL=720h
ALLOW_SIGNUP=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Configure SMTP_HOST/PORT/USERNAME/PASSWORD/FROM_EMAIL or RESEND_API_KEY/FROM_EMAIL for real mail.
# Optional Google: GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET; use FRONTEND_ORIGIN/api/auth/google/callback.
